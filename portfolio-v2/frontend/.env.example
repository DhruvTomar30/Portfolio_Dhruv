# Public URL of this site (used for SEO metadata, sitemap, OG images)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Browser → API origin (no /api suffix). In production: https://api.yourdomain.com
# or https://yourdomain.com if Nginx proxies /api to the backend on the same domain.
NEXT_PUBLIC_API_URL=http://localhost:5050

# Server → API origin used during SSR / builds. On the VPS this can stay on localhost
# so server-side requests don't leave the machine. Falls back to NEXT_PUBLIC_API_URL.
API_URL_INTERNAL=http://localhost:5050
