# Copy to .env (or .env.development / .env.production)
PORT=5050
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=portfolio

# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:3000

# JWT for the admin area — use a long random string (openssl rand -hex 32)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Single admin account. Generate the hash with: pnpm hash-password 'your-password'
ADMIN_EMAIL=dhruvtomar2025@gmail.com
ADMIN_PASSWORD_HASH=

# Contact form email (Gmail: create an App Password at https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=dhruvtomar2025@gmail.com
SMTP_PASS=
CONTACT_RECEIVER_EMAIL=dhruvtomar2025@gmail.com

LOG_LEVEL=info
