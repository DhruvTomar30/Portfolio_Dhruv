{
	"name": "portfolio-backend",
	"version": "1.0.0",
	"description": "Dhruv Tomar portfolio API: Express 5 + Zod + MongoDB",
	"type": "module",
	"main": "index.js",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "NODE_ENV=development nodemon index.js",
		"start": "NODE_ENV=production node index.js",
		"seed": "node scripts/seed.js",
		"hash-password": "node scripts/hash-password.js",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"sync-fallback": "node scripts/sync-fallback.js"
	},
	"imports": {
		"#config/*": "./config/*",
		"#constants/*": "./constants/*",
		"#controllers/*": "./controllers/*",
		"#dtos/*": "./dtos/*",
		"#middlewares/*": "./middlewares/*",
		"#models/*": "./models/*",
		"#routes/*": "./routes/*",
		"#server/*": "./server/*",
		"#services/*": "./services/*",
		"#utils/*": "./utils/*",
		"#validators/*": "./validators/*"
	},
	"dependencies": {
		"bcryptjs": "^3.0.3",
		"compression": "^1.8.2",
		"cors": "^2.8.6",
		"dotenv": "^18.0.9",
		"express": "^5.3.0",
		"express-rate-limit": "^8.7.2",
		"helmet": "^8.3.0",
		"jsonwebtoken": "^9.0.3",
		"mongoose": "^9.11.4",
		"nodemailer": "^10.3.1",
		"winston": "^3.19.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"eslint": "^10.14.0",
		"globals": "^17.13.0",
		"nodemon": "^3.1.14",
		"prettier": "^3.9.10"
	}
}
